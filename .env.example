# MongoDB
MONGO_URI=mongodb://localhost:27017/news-aggregator

# JWT
JWT_SECRET=change_me_to_a_random_32_char_string
JWT_EXPIRY=30d
JWT_EXPIRY_GUEST=7d

# Admin Bootstrap (create on first run)
ADMIN_USER=admin@example.com
ADMIN_PASS=Admin@123!  # Will be hashed automatically on startup

# OAuth (fill when ready, remove or comment out if testing without auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Frontend API URL (for Docker Compose, use http://backend-api:5000)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SERVER_PORT=5000

# --- Scraper ---
# Newest articles considered per source, per run. A ceiling on candidates, not
# inserts: already-stored URLs are skipped, so the first run backfills up to
# this many and later runs only add what is new.
# Days to keep scrape-run logs before they expire automatically
SCRAPE_LOG_RETENTION_DAYS=30
SCRAPER_ARTICLE_LIMIT=20
# Cron schedule for the recurring scrape (default: hourly, on the hour)
SCRAPER_CRON=0 * * * *
# Backfill once at startup instead of waiting for the first cron tick
SCRAPER_RUN_ON_BOOT=true
# Max concurrent article pages
SCRAPER_MAX_CONCURRENT=3
